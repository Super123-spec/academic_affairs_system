# ============ 环境变量配置示例 ============
# 复制本文件为 .env，按实际环境修改后 export 注入。
# Linux:  export $(cat .env | xargs)
# 或用 systemd 的 EnvironmentFile=/path/.env

# ---- 数据库 ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=请改成强密码
MYSQL_DB=edu_admin

# ---- 会话密钥（务必改成随机长字符串，可用 python -c "import secrets;print(secrets.token_hex(32))" 生成）----
SECRET_KEY=请改成随机字符串

# ---- 业务配置 ----
# 当前学期（选课、评教、注册、重修等业务以此为准），跨学期直接改这里，无需改代码
CURRENT_SEMESTER=2025-2026-1
# 管理员新建/重置/批量导入学生、教师账号时的默认初始密码（默认 123456，可直接登录，不强制首次改密；
# 用户自行修改密码时仍走强密码策略：≥8 位且含字母和数字）
DEFAULT_INITIAL_PASSWORD=123456

# ---- 安全 ----
# 若通过 HTTPS 访问，设为 1 开启会话 Cookie 的 Secure 标志
SESSION_COOKIE_SECURE=0
# 【重要】是否部署在反向代理（Nginx 等）之后：
#   0 = 直连部署（默认），登录限流按 TCP 对端 IP 计数，不信任任何 X-Forwarded-For 请求头
#   1 = 反向代理部署，改为信任代理注入的 X-Real-IP / X-Forwarded-For 最右一项
# 直连却设为 1 会让攻击者伪造 IP 绕过登录限流；反代后设为 0 会让所有用户共用代理 IP 互相误锁。
TRUST_PROXY=0
# 若前后端分离跨域部署，配置允许的源（逗号分隔），否则留空（同源部署无需 CORS）
ALLOWED_ORIGINS=
# 开发调试热重载（生产务必保持 0 或删除）
FLASK_DEBUG=0

# ---- 反向代理传来的真实 IP（仅 gunicorn 使用，配合 TRUST_PROXY=1）----
# 只信任本机代理，其余来源的 X-Forwarded-For 一律忽略
FORWARDED_ALLOW_IPS=127.0.0.1
